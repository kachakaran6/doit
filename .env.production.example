# ===== Core =====
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://api.example.com
LOG_LEVEL=info

# ===== Database (use Coolify's INTERNAL Postgres URL) =====
DATABASE_URL=postgresql://doit:CHANGE_ME@<internal-db-host>:5432/doit

# ===== Auth (generate each with: openssl rand -base64 48) =====
JWT_SECRET=CHANGE_ME_MIN_32_CHARACTERS_LONG_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARACTERS_LONG_REFRESH_SECRET
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
COOKIE_SECRET=CHANGE_ME_COOKIE_SECRET
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ===== CORS / web =====
CORS_ORIGINS=https://app.example.com
TRUST_PROXY=1

# ===== Storage =====
STORAGE_DRIVER=s3            # s3 | local
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # or http://<internal-minio-host>:9000
S3_REGION=auto
S3_BUCKET=doit-uploads
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true     # true for MinIO
UPLOAD_DIR=/app/uploads      # only if STORAGE_DRIVER=local
MAX_IMAGE_MB=10
MAX_AUDIO_MB=20
ATTACHMENT_RETENTION_DAYS=180

# ===== Speech-to-text =====
ASR_PROVIDER=none            # none | local | openai | sarvam
ASR_URL=                     # for local ASR service (internal URL)
OPENAI_API_KEY=
SARVAM_API_KEY=
ASR_MAX_SECONDS=300
ASR_MONTHLY_CAP_MINUTES=600

# ===== Mail (password reset / invites). Dev: leave empty = log link =====
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="DoIt <no-reply@example.com>"

# ===== Push (Firebase Admin) =====
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ===== Observability =====
SENTRY_DSN=

# ===== Client policy =====
MIN_APP_VERSION=0.1.0

# ===== AI provider credentials (placeholder only; generate with openssl rand -base64 32) =====
AI_CREDENTIALS_KEY=CHANGE_ME_MIN_16_CHARACTERS
AI_CONTEXT_MAX_CHARS=32000

