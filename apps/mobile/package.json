{
  "name": "@doit/mobile",
  "version": "0.2.4",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:apk": "eas build -p android --profile preview",
    "build:apk:local": "expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease",
    "build:aab": "eas build -p android --profile production",
    "typecheck": "node --max-old-space-size=4096 ../../node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" App.tsx",
    "test": "node -e \"console.log('Mobile tests ready')\""
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@tanstack/react-query": "^5.105.0",
    "expo": "~52.0.37",
    "expo-av": "~15.0.2",
    "expo-clipboard": "~7.0.1",
    "expo-secure-store": "~14.0.1",
    "expo-sensors": "~14.0.2",
    "expo-status-bar": "~2.0.1",
    "lucide-react-native": "^1.64.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "^5.8.2"
  }
}