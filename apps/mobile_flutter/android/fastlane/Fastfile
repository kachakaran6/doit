# Fastlane configuration for DoIt Flutter Mobile (Android)
default_platform(:android)

platform :android do

  def resolve_play_store_key
    candidates = [
      ENV["PLAY_STORE_JSON_KEY"],
      File.expand_path("api-key.json", __dir__),
      File.expand_path("../api-key.json", __dir__),
      File.expand_path("../../api-key.json", __dir__),
      File.expand_path("../../../api-key.json", __dir__),
      File.expand_path("../../../../api-key.json", __dir__)
    ].compact

    candidates.find { |path| File.exist?(path) && !File.zero?(path) }
  end

  # ─────────────────────────────────────────────────────────────────────────────
  # Automatic Version & Build Number Manager
  # ─────────────────────────────────────────────────────────────────────────────

  # Computes the next version name adhering to:
  # 1.0.1 -> 1.0.2 ... 1.0.20 -> 1.1.1 -> 1.1.2 ... 1.1.20 -> 1.2.1 ...
  def calculate_next_version_name(current_version_name)
    parts = current_version_name.to_s.split(".").map(&:to_i)
    major = parts[0] || 1
    minor = parts[1] || 0
    patch = parts[2] || 0

    next_patch = patch + 1
    next_minor = minor
    next_major = major

    # Roll over to next minor once patch exceeds 20
    if next_patch > 20
      next_patch = 1
      next_minor = minor + 1
      if next_minor > 20
        next_minor = 0
        next_major = major + 1
      end
    end

    "#{next_major}.#{next_minor}.#{next_patch}"
  end

  def get_target_version_and_build(options)
    root_dir = File.expand_path("../..", __dir__)
    pubspec_path = File.join(root_dir, "pubspec.yaml")
    UI.user_error!("pubspec.yaml not found at #{pubspec_path}") unless File.exist?(pubspec_path)

    content = File.read(pubspec_path)
    match = content.match(/^version:\s*([^\s+]+)\+(\d+)/)
    UI.user_error!("Could not parse version in #{pubspec_path}") unless match

    current_version_name = match[1]
    current_build = match[2].to_i

    # Compute default next values
    default_next_version_name = calculate_next_version_name(current_version_name)
    next_build = current_build + 1

    target_build = if options[:build_number]
      options[:build_number].to_i
    elsif options[:version_code]
      options[:version_code].to_i
    elsif UI.interactive? && !options[:non_interactive]
      prompt_val = UI.input("Enter build number (current: #{current_build}, default: #{next_build}):").strip
      prompt_val.empty? ? next_build : prompt_val.to_i
    else
      next_build
    end

    target_build = next_build if target_build.nil? || target_build <= 0

    target_version_name = if options[:version_name]
      options[:version_name].to_s.strip
    elsif options[:version]
      options[:version].to_s.strip
    elsif UI.interactive? && !options[:non_interactive]
      prompt_val = UI.input("Enter version name (current: #{current_version_name}, default: #{default_next_version_name}):").strip
      prompt_val.empty? ? default_next_version_name : prompt_val
    else
      default_next_version_name
    end

    target_version_name = default_next_version_name if target_version_name.nil? || target_version_name.empty?

    # Persist version bump to pubspec.yaml
    if target_build != current_build || target_version_name != current_version_name
      UI.message("⬆️ Updating Flutter version in pubspec.yaml: #{target_version_name}+#{target_build} (was #{current_version_name}+#{current_build})...")
      updated_content = content.sub(/^version:\s*[^\r\n]+/, "version: #{target_version_name}+#{target_build}")
      File.write(pubspec_path, updated_content)

      # Sync Settings screen version display
      settings_path = File.join(root_dir, "lib", "features", "settings", "screens", "settings_screen.dart")
      if File.exist?(settings_path)
        s_content = File.read(settings_path)
        s_content = s_content.gsub(/Version\s+[0-9\.]+\s*\(Build\s*\d+\)/, "Version #{target_version_name} (Build #{target_build})")
        s_content = s_content.gsub(/Version\s+[0-9\.]+\s*Build\s*\d+/, "Version #{target_version_name} Build #{target_build}")
        File.write(settings_path, s_content)
      end
    else
      UI.message("ℹ️ Using existing version: #{target_version_name}+#{target_build}")
    end

    { version_name: target_version_name, build_number: target_build }
  end

  # Helper: Build Release AAB Bundle with version parameters & archive locally
  def build_flutter_aab(version_name, build_number)
    UI.message("🔨 Building Flutter release AAB for v#{version_name}+#{build_number}...")
    sh("cd ../.. && flutter build appbundle --release --build-name=#{version_name} --build-number=#{build_number}")

    source_aab = File.expand_path("../../build/app/outputs/bundle/release/app-release.aab", __dir__)
    UI.user_error!("AAB build failed! Could not find #{source_aab}") unless File.exist?(source_aab)

    # Archive to release-builds directory
    releases_dir = File.expand_path("../../../../release-builds", __dir__)
    FileUtils.mkdir_p(releases_dir)
    target_aab = File.join(releases_dir, "DoIt-v#{version_name}-build#{build_number}.aab")
    FileUtils.cp(source_aab, target_aab)
    UI.success("📦 Release bundle archived at: #{target_aab}")

    source_aab
  end

  desc "Autoincrement version & build, compile release AAB, and upload to Google Play Internal testing track"
  lane :internal do |options|
    info = get_target_version_and_build(options)
    aab = build_flutter_aab(info[:version_name], info[:build_number])
    key = resolve_play_store_key
    UI.user_error!("Google Play service account key (api-key.json) not found!") if key.nil?

    UI.message("🚀 Deploying build #{info[:version_name]}+#{info[:build_number]} to Google Play [internal] track...")
    upload_to_play_store(
      track: "internal",
      aab: aab,
      json_key: key,
      package_name: "com.samyukt.doit",
      release_status: options[:release_status] || "completed",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
    UI.success("✨ Successfully deployed build #{info[:build_number]} to Google Play Internal Testing track!")
  end

  desc "Autoincrement version & build, compile release AAB, and upload to Google Play Closed testing (alpha) track"
  lane :closed do |options|
    info = get_target_version_and_build(options)
    aab = build_flutter_aab(info[:version_name], info[:build_number])
    key = resolve_play_store_key
    UI.user_error!("Google Play service account key (api-key.json) not found!") if key.nil?

    UI.message("🚀 Deploying build #{info[:version_name]}+#{info[:build_number]} to Google Play [alpha/closed] track...")
    upload_to_play_store(
      track: "alpha",
      aab: aab,
      json_key: key,
      package_name: "com.samyukt.doit",
      release_status: options[:release_status] || "completed",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
    UI.success("✨ Successfully deployed build #{info[:build_number]} to Google Play Closed Testing track!")
  end

  desc "Autoincrement version & build, compile AAB, and deploy to BOTH Google Play Internal and Closed tracks"
  lane :deploy_both do |options|
    info = get_target_version_and_build(options)
    aab = build_flutter_aab(info[:version_name], info[:build_number])
    key = resolve_play_store_key
    UI.user_error!("Google Play service account key (api-key.json) not found!") if key.nil?

    UI.message("🚀 Step 1/2: Deploying build #{info[:version_name]}+#{info[:build_number]} to Google Play [internal] track...")
    upload_to_play_store(
      track: "internal",
      aab: aab,
      json_key: key,
      package_name: "com.samyukt.doit",
      release_status: options[:release_status] || "completed",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
    UI.success("✨ Uploaded to Internal Testing track!")

    UI.message("🚀 Step 2/2: Promoting build #{info[:build_number]} to Google Play [closed/alpha] track...")
    upload_to_play_store(
      track: "internal",
      track_promote_to: "alpha",
      version_code: info[:build_number],
      json_key: key,
      package_name: "com.samyukt.doit",
      release_status: options[:release_status] || "completed",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
    UI.success("🎉 Successfully deployed build #{info[:build_number]} to BOTH Internal & Closed tracks!")
  end

  desc "Promote latest release from Internal track to Closed Testing (alpha) track without rebuilding"
  lane :promote_to_closed do |options|
    key = resolve_play_store_key
    UI.user_error!("Google Play service account key (api-key.json) not found!") if key.nil?

    upload_to_play_store(
      track: "internal",
      track_promote_to: "alpha",
      json_key: key,
      package_name: "com.samyukt.doit",
      release_status: options[:release_status] || "completed",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
    UI.success("🎉 Successfully promoted latest Internal release to Closed Testing track!")
  end

  desc "Upload Flutter release bundle to Google Play Production track"
  lane :production do |options|
    info = get_target_version_and_build(options)
    aab = build_flutter_aab(info[:version_name], info[:build_number])
    key = resolve_play_store_key
    UI.user_error!("Google Play service account key (api-key.json) not found!") if key.nil?

    UI.message("🚀 Deploying build #{info[:version_name]}+#{info[:build_number]} to Google Play [production] track...")
    upload_to_play_store(
      track: "production",
      aab: aab,
      json_key: key,
      package_name: "com.samyukt.doit",
      release_status: options[:release_status] || "completed",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
    UI.success("✨ Successfully deployed build #{info[:build_number]} to Google Play Production track!")
  end

end
