{
  "name": "samyukt-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "turbo run build && node scripts/sync-packages.mjs",
    "dev": "turbo run dev",
    "lint": "eslint \"**/*.ts\" \"**/*.tsx\" --ignore-pattern \"docs/**\" --ignore-pattern \"apps/mobile/android/**\" --ignore-pattern \"apps/mobile/ios/**\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:reset": "pnpm --filter @doit/api run db:reset",
    "db:seed:prod": "pnpm --filter @doit/api run db:seed:prod",
    "mobile:apk": "pnpm --filter @doit/mobile run build:apk",
    "mobile:apk:local": "pnpm --filter @doit/mobile run build:apk:local",
    "mobile:aab": "pnpm --filter @doit/mobile run build:aab",
    "mobile:dev": "pnpm --filter @doit/mobile run start:dev",
    "release:internal": "node scripts/release-playstore.mjs --track=internal",
    "release:closed": "node scripts/release-playstore.mjs --track=closed",
    "release:production": "node scripts/release-playstore.mjs --track=production",
    "release:bump": "node scripts/release-playstore.mjs --bump --track=internal",
    "smoke": "node scripts/smoke-api.mjs",
    "postinstall": "node scripts/sync-packages.mjs && node scripts/patch-codegen.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
