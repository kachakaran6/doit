{
  "name": "samyukt-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "turbo run build && node scripts/sync-packages.mjs",
    "dev": "turbo run dev",
    "lint": "eslint \"**/*.ts\" \"**/*.tsx\" --ignore-pattern \"docs/**\" --ignore-pattern \"doit-*/**\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "postinstall": "node scripts/sync-packages.mjs && node scripts/patch-codegen.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
