meta {
  name: Create Task
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/projects/{{projectId}}/tasks
  body: json
  auth: bearer
}

headers {
  idempotency-key: 11111111-2222-3333-4444-555555555555
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "title": "Fix login crash on 3G network",
    "description": "App closes immediately when submit button is pressed",
    "priority": "HIGH",
    "type": "TASK",
    "source": "OVERLAY"
  }
}
