{
  "_note": "Starting palette. Every text/background pair in contrastPairs MUST pass scripts/contrast.py (>= 4.5 text, >= 3 for large/UI). Tune hues by eye on a real OLED phone, then re-run the script.",
  "dark": {
    "canvas": "#0B0B0E",
    "surface1": "#141418",
    "surface2": "#1C1C22",
    "surface3": "#25252C",
    "hairline": "rgba(255,255,255,0.07)",
    "text": { "primary": "#F5F5F7", "secondary": "#A3A3AD", "tertiary": "#868691" },
    "success": { "fill": "#0E8550", "text": "#5FD38D", "soft": "rgba(95,211,141,0.14)" },
    "warning": { "fill": "#A15E00", "text": "#FFB84D", "soft": "rgba(255,184,77,0.14)" },
    "danger":  { "fill": "#C93C35", "text": "#FF7A72", "soft": "rgba(255,122,114,0.14)" }
  },
  "light": {
    "canvas": "#F4F4F7",
    "surface1": "#FFFFFF",
    "surface2": "#F0F0F4",
    "surface3": "#E8E8EE",
    "hairline": "rgba(0,0,0,0.08)",
    "text": { "primary": "#16161A", "secondary": "#5B5B66", "tertiary": "#6B6B77" },
    "success": { "fill": "#0E8550", "text": "#18794E", "soft": "rgba(14,133,80,0.10)" },
    "warning": { "fill": "#A15E00", "text": "#9A5B00", "soft": "rgba(178,106,0,0.10)" },
    "danger":  { "fill": "#C93C35", "text": "#C8322B", "soft": "rgba(201,60,53,0.09)" }
  },
  "accents": {
    "blue":   { "fillLight": "#2F5BEA", "fillDark": "#3A66F2", "textLight": "#2750D8", "textDark": "#8FAEFF" },
    "violet": { "fillLight": "#7B54E8", "fillDark": "#7B54E8", "textLight": "#6A3FD6", "textDark": "#B9A3FF" },
    "green":  { "fillLight": "#0E8550", "fillDark": "#0E8550", "textLight": "#18794E", "textDark": "#5FD38D" },
    "orange": { "fillLight": "#C24E07", "fillDark": "#C24E07", "textLight": "#B24400", "textDark": "#FFA066" },
    "rose":   { "fillLight": "#D6305A", "fillDark": "#D6305A", "textLight": "#C1234B", "textDark": "#FF8BA7" }
  },
  "defaultAccent": "blue",
  "contrastPairs": [
    ["dark.text.primary", "dark.surface1", 4.5], ["dark.text.primary", "dark.surface3", 4.5],
    ["dark.text.secondary", "dark.surface1", 4.5], ["dark.text.secondary", "dark.surface2", 4.5],
    ["dark.text.tertiary", "dark.surface2", 4.5],
    ["dark.success.text", "dark.surface1", 4.5], ["dark.warning.text", "dark.surface1", 4.5], ["dark.danger.text", "dark.surface1", 4.5],
    ["light.text.primary", "light.surface1", 4.5], ["light.text.primary", "light.canvas", 4.5],
    ["light.text.secondary", "light.surface1", 4.5], ["light.text.secondary", "light.canvas", 4.5],
    ["light.text.tertiary", "light.surface1", 4.5], ["light.text.tertiary", "light.canvas", 4.5],
    ["light.success.text", "light.surface1", 4.5], ["light.warning.text", "light.surface1", 4.5], ["light.danger.text", "light.surface1", 4.5]
  ],
  "accentPairs": {
    "onFill": "#FFFFFF",
    "rules": ["white on fillLight >= 4.5", "white on fillDark >= 4.5", "textLight on light.surface1 >= 4.5", "textDark on dark.surface1 >= 4.5"]
  }
}
