# Server-only secrets. Configure in Coolify/secret manager, never in Expo public
# variables or browser-exposed NEXT_PUBLIC_/VITE_ variables.

# 32-byte or stronger secret key material for authenticated encryption.
# Generate and manage securely. Do not commit a real value.
AI_CREDENTIAL_ENCRYPTION_KEY=

# Optional: server-side AI provider defaults. User-specific credentials should
# be stored securely through the backend credential-management flow.
AI_DEFAULT_PROVIDER=
AI_DEFAULT_MODEL=

# Optional safety limits; implement/validate server-side.
AI_MAX_PROJECT_CONTEXT_CHARS=30000
AI_MAX_SELECTED_ATTACHMENTS=5
AI_GENERATION_RATE_LIMIT_PER_HOUR=20

# Public API base URL belongs in the existing client configuration using the
# repository's actual variable names. Do not invent or expose secrets here.
